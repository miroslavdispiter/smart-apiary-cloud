# Normalize line endings: LF in the repository, native line endings in the working folder
* text=auto

# Windows-only files keep CRLF
*.sln   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts must stay LF
*.sh    text eol=lf

# Better diffs
*.cs    text diff=csharp

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.dll   binary
*.exe   binary
